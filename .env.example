# Argus — example environment configuration
# Copy to .env and fill in API keys before running.
# All settings are ARGUS_-prefixed except the raw API keys below.

# ─── LLM Provider Keys ────────────────────────────────────────────────────────
# At least one key is required; Argus uses Groq as primary and Gemini as fallback.
ARGUS_GROQ_API_KEY=your_groq_key_here
ARGUS_GEMINI_API_KEY=your_gemini_key_here

# ─── Provider Routing ─────────────────────────────────────────────────────────
ARGUS_PRIMARY_PROVIDER=groq
ARGUS_FALLBACK_PROVIDER=gemini

# ─── Persistence Paths ────────────────────────────────────────────────────────
ARGUS_DB_PATH=data/argus.db
ARGUS_CHECKPOINTS_DB_PATH=data/checkpoints.db

# ─── Rate Limiting ────────────────────────────────────────────────────────────
ARGUS_RATE_LIMIT_RPM=30

# ─── Retry / Backoff ──────────────────────────────────────────────────────────
ARGUS_MAX_RETRIES=3
ARGUS_RETRY_BASE_DELAY=1.0
ARGUS_RETRY_MAX_DELAY=30.0

# ─── Review Limits ────────────────────────────────────────────────────────────
ARGUS_MAX_DIFF_LINES=2000

# ─── Static Analysis ──────────────────────────────────────────────────────────
ARGUS_COMPLEXITY_THRESHOLD=10

# ─── API Security ─────────────────────────────────────────────────────────────
ARGUS_API_KEY=dev-secret-key

# ─── Critic / Report Loop Bounds ──────────────────────────────────────────────
ARGUS_MAX_REFINE_ITERATIONS=3
ARGUS_MAX_REPORT_ITERATIONS=3
